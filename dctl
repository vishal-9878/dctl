#!/usr/bin/env bash
# Run the dctl CLI straight from a git clone (no install needed).
src="$0"
while [ -L "$src" ]; do t=$(readlink "$src"); case "$t" in /*) src="$t";; *) src="$(dirname "$src")/$t";; esac; done
here=$(cd "$(dirname "$src")" && pwd)
export PYTHONPATH="$here/src${PYTHONPATH:+:$PYTHONPATH}" DCTL_PY="${DCTL_PY:-python3}"
exec bash "$here/src/dctl/dctl.sh" "$@"
